# Copy to .env for local development. On Render, set these in the dashboard.
NODE_ENV=development
PORT=5000

# Same value as BACKEND_JWT_SECRET in the Next.js app. Generate with: openssl rand -base64 48
BACKEND_JWT_SECRET=

# MongoDB Atlas connection string; MONGODB_DB is the database this server uses.
MONGODB_URI=
MONGODB_DB=chatbot

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
MAX_OUTPUT_TOKENS=1024
CONTEXT_MESSAGES=10

# Requests per day. The Gemini key is shared, so the global cap protects it.
DAILY_USER_LIMIT=50
DAILY_GUEST_LIMIT=10
DAILY_GLOBAL_LIMIT=500
