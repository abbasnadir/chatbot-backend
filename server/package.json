{
  "name": "server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/server.js",
    "dev": "nodemon --watch src --ext ts --exec tsx src/server.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^1.38.0",
    "cookie-parser": "~1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.22.1",
    "express-rate-limit": "^8.2.1",
    "jose": "^6.1.3",
    "mongodb": "^7.8.0",
    "morgan": "^1.10.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^25.0.10",
    "@types/supertest": "^7.2.1",
    "nodemon": "^3.1.11",
    "supertest": "^7.3.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
